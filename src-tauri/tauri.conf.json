{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Decathlon Schedule Builder",
  "version": "1.0.1",
  "identifier": "com.avisanchez.decathlon-schedule-builder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Decathlon Schedule Builder",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxQTkwOTE5NDVENEQyOEEKUldTSzB0UkZHUW1wc1lCS2kzZ0N0T1hXWEM4MEYzd0lRR0F3c1QwMGNqRWNRdUx4aWlwaldDZzMK",
      "endpoints": [
        "https://github.com/avisanchez/decathlon-schedule-builder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}